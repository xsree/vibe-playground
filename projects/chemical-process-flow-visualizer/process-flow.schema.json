{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/process-flow.schema.json",
  "title": "轻量工艺流程连接图",
  "description": "描述物料来源、工艺设备、物料去向及其连接关系。设备类型和形状键保持开放，以支持未来扩展。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "functionalAreas",
    "nodes",
    "edges",
    "layout",
    "settings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "functionalAreas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/functionalArea"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "functionalArea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "nodeIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "direction",
        "role"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "direction": {
          "type": "string",
          "enum": [
            "in",
            "out",
            "bidirectional"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "开放字符串，例如 material、gas、waste、recycle、utility。"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "tag",
        "name",
        "equipmentType",
        "shapeKey",
        "ports",
        "attributes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "equipment",
            "source",
            "sink",
            "junction"
          ]
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "equipmentType": {
          "type": [
            "string",
            "null"
          ],
          "description": "设备的原始或归一化名称，不限制为固定枚举。"
        },
        "shapeKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "description": "形状注册表中的键；未知键由渲染器回退为 generic.process。"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "attributes": {
          "type": "object",
          "description": "可扩展属性袋，仅在这里允许自由增加设备属性。",
          "additionalProperties": true
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "portId"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/identifier"
        },
        "portId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "label",
        "streamType",
        "material",
        "attributes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "$ref": "#/$defs/endpoint"
        },
        "target": {
          "$ref": "#/$defs/endpoint"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "streamType": {
          "type": "string",
          "minLength": 1,
          "description": "开放字符串，推荐 main、feed、gas、waste、recycle、product、utility。"
        },
        "material": {
          "$ref": "#/$defs/material"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "nodeLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "edgeLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routing",
        "waypoints"
      ],
      "properties": {
        "routing": {
          "type": "string",
          "enum": [
            "straight",
            "orthogonal"
          ]
        },
        "waypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "algorithm",
        "direction",
        "nodes",
        "edges"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ]
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "RIGHT",
            "LEFT",
            "DOWN",
            "UP"
          ]
        },
        "nodes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/nodeLayout"
          }
        },
        "edges": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/edgeLayout"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultRouting",
        "nodeSpacing",
        "layerSpacing",
        "preventNodeOverlap"
      ],
      "properties": {
        "defaultRouting": {
          "type": "string",
          "enum": [
            "straight",
            "orthogonal"
          ]
        },
        "nodeSpacing": {
          "type": "number",
          "minimum": 0
        },
        "layerSpacing": {
          "type": "number",
          "minimum": 0
        },
        "preventNodeOverlap": {
          "type": "boolean"
        }
      }
    }
  }
}
